{
  "name": "devspark-backend",
  "version": "1.0.0",
  "description": "DevsParkLabs Website Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --quiet server.js",
    "server": "nodemon --quiet server.js",
    "build": "npm install --legacy-peer-deps",
    "check": "node --check server.js && node -e \"require('./app')\"",
