# MongoDB connection URI, e.g. mongodb+srv://<username>:<password>@<cluster>/<database>
DATABASE=

# Gmail address used to send transactional emails (password reset, etc.)
GMAIL_USER=

# Gmail App Password for GMAIL_USER (not the regular account password)
# Generate at https://myaccount.google.com/apppasswords (requires 2FA enabled)
GMAIL_PASS=

# Number of days before the authentication cookie expires, e.g. 30
JWT_COOKIE_EXPIRES_IN=

# Authentication token lifetime, e.g. 30d or 90d
JWT_EXPIRES_IN=

# Long, random, private string used to sign authentication tokens
JWT_SECRET=

# Runtime mode: development, production, or test
NODE_ENV=

# Local API port, e.g. 8000 (macOS AirPlay may already use port 5000)
PORT=
